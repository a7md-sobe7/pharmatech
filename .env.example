NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database Configuration
# Leave blank to automatically start embedded in-memory MongoDB for zero-configuration local execution,
# or set to a real MongoDB URI: mongodb://localhost:27017/pharmamatch
MONGO_URI=

# JWT Authentication
JWT_SECRET=pharmamatch_super_secure_jwt_secret_key_2026_clinical
JWT_EXPIRES_IN=7d

# AI Orchestration Provider (options: 'mock', 'gemini', 'openai')
# Default is 'mock' which executes high-accuracy deterministic tool calling locally without external keys
AI_PROVIDER=mock
AI_API_KEY=

# Logging Level
LOG_LEVEL=info
